corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="InventoryUI" type="CanvasLayer"]
layer = 3
script = ExtResource("1_ui")

[node name="Panel" type="PanelContainer" parent="."]
