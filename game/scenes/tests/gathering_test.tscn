[ext_resource type="PackedScene" path="res://ui/gathering/gathering_hud.tscn" id="6_hud"]

[node name="GatheringTest" type="Node2D"]
script = ExtResource("1_map")

[node name="Interaction" parent="." instance=ExtResource("2_interaction")]

[node name="GatheringPoints" parent="." instance=ExtResource("3_points")]

[node name="InventoryController" type="Node" parent="."]
