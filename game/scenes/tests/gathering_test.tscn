[node name="InventoryUI" parent="." instance=ExtResource("5_ui")]

[node name="FixtureHud" type="CanvasLayer" parent="."]
layer = 2

[node name="StoreButton" type="Button" parent="FixtureHud"]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -96.0
offset_top = 22.0
